{
  "name": "@gasboost/bootstrap",
  "version": "0.4.0",
  "description": "First-run initialization for Google Apps Script web applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasboost/app.git",
    "directory": "packages/bootstrap"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "dependencies": {
    "@gasboost/app": "workspace:^5.5.0"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.12",
    "@gasboost/client": "workspace:*",
    "@gasboost/auth": "0.9.0",
    "react": "^19",
    "react-dom": "^19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "~19.2.7",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.0.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs",
    "test:integration": "node --test integration/auth.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@gasboost/auth": "^0.9.0",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
