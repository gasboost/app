{
  "name": "@gasboost/vite",
  "version": "1.2.0",
  "description": "A Vite plugin for building @gasboost/app applications for Google Apps Script.",
  "keywords": [
    "google-apps-script",
    "gas",
    "vite",
    "typescript",
    "plugin",
    "build",
    "bundler",
    "serverless",
    "gasboost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasboost/app.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/google-apps-script": "^2.0.12",
    "vite": "^8.2.2",
    "@gasboost/client": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && vite build --config vite.package.config.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@gasboost/app": "workspace:*",
    "@gasboost/fake-core": "^0.1.2",
    "@gasboost/fake-node": "^0.1.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
